# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /prodterra
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prodterra?retryWrites=true&w=majority

# Port for this API (the web app runs on 3000)
PORT=4000

# Web app origins allowed by CORS, separated by commas
WEB_ORIGIN=http://localhost:3000
