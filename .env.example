# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database inside the cluster: prodterra-dev on your machine, prodterra in production (required)
DB_NAME=prodterra-dev

# Port for this API (the web app runs on 3000)
PORT=4000

# Web app origins allowed by CORS, separated by commas
WEB_ORIGIN=http://localhost:3000

SESSION_COOKIE_DOMAIN=

# Web app address used in email links and after Google sign in
WEB_APP_URL=http://localhost:3000

# Google sign in (Google Cloud Console > APIs & Services > Clients > Web application)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Gmail account that sends account emails, with an app password (myaccount.google.com/apppasswords)
# Leave empty to print emails in the API log instead
GMAIL_USER=
GMAIL_APP_PASSWORD=
